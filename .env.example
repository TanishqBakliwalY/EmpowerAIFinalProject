# Copy to .env (in this folder, or in the folder ABOVE this repo) and fill in your key.
# Never commit .env.

# Required: every agent calls gpt-6-luna through the Portkey gateway with this key.
PORTKEY_API_KEY=your-portkey-api-key-here

# ---- Optional ---------------------------------------------------------------
# Token prices used to turn measured tokens into dollars (USD per 1M tokens). Defaults = published gpt-6-luna rates.
# PRICE_INPUT_PER_M=0.10
# PRICE_CACHED_INPUT_PER_M=0.01
# PRICE_OUTPUT_PER_M=0.50

# Hard stop for AI spend across all runs on this server, per UTC day (USD).
# DAILY_BUDGET_USD=5

# Run on real company data instead of the synthetic demo data (same file layout as data/seed/).
# EMPOWER_DATA_DIR=_private/data

# The course gateway can replay a cached answer for a request it has seen before. By default the app asks for a fresh
# answer every time, so runs are real and the token/cost meter is exact. Set to 1 to accept cached replies (cheaper demos).
# PORTKEY_ALLOW_CACHE=0
